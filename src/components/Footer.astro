---
// Paris footer structure (brand column + Services / Company / Contact +
// "Where we paint" row + legal bar) in CertaPro's yellow footer with
// charcoal text and a light-gray legal bar.
import { Image } from 'astro:assets';
import { SERVICES, CONTACT, AREA_PAGES, BADGES, PROFILES, REVIEW_FUNNEL } from '../consts';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';

const year = new Date().getFullYear();
const socials = [
  { key: 'facebook', label: 'Facebook', href: PROFILES.facebook },
  { key: 'nextdoor', label: 'Nextdoor', href: PROFILES.nextdoor },
  { key: 'google', label: 'Google Business Profile', href: PROFILES.google },
] as const;
---

<footer class="site-footer bg-primary pb-[4.5rem] text-secondary lg:pb-0">
  <div class="wrap grid gap-12 py-14 md:grid-cols-2 lg:grid-cols-[1.35fr_1fr_1fr_1.25fr] lg:gap-10">
    <div>
      <a href="/" aria-label="Huerta's Painting — home" class="inline-block rounded-card bg-paper px-4 py-3 shadow-sm"><Logo class="h-16 w-auto" loading="lazy" /></a>
      <p class="mt-5 max-w-[20rem] text-[0.92rem] leading-[1.65]">
        Interior and exterior house painting, drywall and ceiling repair, and deck refinishing for Apple Valley and the
        Twin Cities South Metro since 2018. Family-owned, fully insured, workmanship guaranteed.
      </p>
      <div class="mt-5 flex items-center gap-3">
        <a href={BADGES.nextdoor.href} target="_blank" rel="noopener noreferrer" class="rounded-card bg-paper p-1"><Image src={BADGES.nextdoor.src} alt={BADGES.nextdoor.alt} width={96} class="h-12 w-12 object-contain" loading="lazy" /></a>
        <a href={BADGES.bbb.href} target="_blank" rel="noopener noreferrer" class="flex h-14 items-center rounded-card bg-paper px-2"><Image src={BADGES.bbb.src} alt={BADGES.bbb.alt} width={200} class="h-9 w-auto object-contain" loading="lazy" /></a>
      </div>
    </div>

    <div>
      <h2 class="text-[1.5rem] font-light">Services</h2>
      <ul class="mt-5 space-y-3 text-[0.95rem]">
        {SERVICES.map((s) => <li><a href={`/services/${s.slug}/`} class="hover:underline">{s.name}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="text-[1.5rem] font-light">Company</h2>
      <ul class="mt-5 space-y-3 text-[0.95rem]">
        <li><a href="/about/" class="hover:underline">About Huerta's Painting</a></li>
        <li><a href="/gallery/" class="hover:underline">Before &amp; After Gallery</a></li>
        <li><a href="/services/" class="hover:underline">All Services</a></li>
        <li><a href="/contact-us/" class="hover:underline">Contact &amp; Free Estimate</a></li>
        <li><a href={REVIEW_FUNNEL.start} class="hover:underline">Leave Us a Review</a></li>
      </ul>
    </div>

    <div class="lg:border-l lg:border-secondary/15 lg:pl-10">
      <h2 class="text-[1.5rem] font-light">Contact</h2>
      <ul class="mt-5 space-y-3.5 text-[0.95rem]">
        <li>
          <a href={`tel:${CONTACT.phoneTel}`} class="flex items-center gap-3 text-[1.35rem] font-bold hover:underline">
            <Icon name="phone" size={20} stroke={2} />{CONTACT.phoneDisplay}
          </a>
          <span class="ml-8 text-[0.8rem]">Call or text</span>
        </li>
        <li class="flex items-start gap-3"><Icon name="mail" size={18} stroke={1.8} class="mt-1 shrink-0" /><a href={`mailto:${CONTACT.email}`} class="hover:underline">{CONTACT.email}</a></li>
        <li class="flex items-start gap-3"><Icon name="pin" size={18} stroke={1.8} class="mt-1 shrink-0" />{CONTACT.city}</li>
        <li class="flex items-start gap-3"><Icon name="shield" size={18} stroke={1.8} class="mt-1 shrink-0" />Fully registered &amp; insured</li>
      </ul>
      <a href="/contact-us/#estimate" class="btn btn-dark mt-6">Free Estimate</a>
    </div>
  </div>

  <div class="wrap">
    <p class="border-t border-secondary/15 py-6 text-[0.88rem] leading-[1.9]">
      <strong class="font-bold">Where we paint:</strong>
      {
        AREA_PAGES.map((a, i) => (
          <>
            <a href={`/${a.slug}/`} class="hover:underline">{a.city}</a>
            {i < AREA_PAGES.length - 1 && <span class="mx-1 opacity-50">·</span>}
          </>
        ))
      }
    </p>
    <ul class="flex justify-center gap-5 pb-8">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer" data-profile={s.key} aria-label={s.label} class="flex h-11 w-11 items-center justify-center text-secondary transition-transform hover:-translate-y-0.5" style="--nd-cut:#FDB913">
              <BrandIcon name={s.key} size={30} mono />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="footer-legal bg-surface">
    <div class="wrap flex flex-col gap-2 py-4 text-[0.82rem] text-body sm:flex-row sm:items-center sm:justify-between">
      <p>© 2018–{year} Huerta's Painting, LLC. All rights reserved.</p>
      <p class="flex flex-wrap gap-x-3">
        <a href="/contact-us/" class="hover:underline">Contact</a><span aria-hidden="true">|</span>
        <a href={REVIEW_FUNNEL.start} class="hover:underline">Leave a Review</a><span aria-hidden="true">|</span>
        <a href="/#faq" class="hover:underline">FAQs</a>
      </p>
    </div>
  </div>
</footer>
