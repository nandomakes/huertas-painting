---
// Paris closing band, CertaPro look: charcoal band ("Schedule a free
// estimate.") with the yellow button and a white call button.
import { CONTACT } from '../consts';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Schedule a free estimate.',
  text = 'Free in-home estimate, a custom quote, and a family-owned team that treats your home like their own.',
} = Astro.props;
---

<section class="cta-band border-t-4 border-primary bg-secondary text-paper">
  <div class="wrap flex flex-col gap-7 py-12 md:flex-row md:items-center md:justify-between md:py-14">
    <div>
      <h2 class="reveal text-[clamp(1.6rem,1.2rem+1.4vw,2.1rem)] font-bold leading-tight">{title}</h2>
      <p class="reveal mt-2 max-w-[36rem] text-[0.98rem] text-paper/80">{text}</p>
    </div>
    <div class="reveal flex shrink-0 flex-wrap gap-3">
      <a href="#estimate" class="btn btn-primary">Contact Us</a>
      <a href={`tel:${CONTACT.phoneTel}`} class="btn btn-light">Call {CONTACT.phoneDisplay}</a>
    </div>
  </div>
</section>
